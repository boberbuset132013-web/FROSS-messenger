rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function verified() {
      return signedIn() && (
        request.auth.token.email_verified == true
        || request.auth.token.legacyAccount == true
      );
    }
    function own(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function canReadChat(chatId) {
      return verified() && (
        chatId == "general" ||
        (exists(/databases/$(database)/documents/chats/$(chatId))
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberUids)
      );
    }

    match /usernameIndex/{usernameLower} {
      allow get: if true;
      allow list: if false;
      allow create: if own(request.resource.data.uid)
        && request.resource.data.usernameLower == usernameLower
        && request.resource.data.username is string
        && request.resource.data.username == usernameLower
        && getAfter(/databases/$(database)/documents/publicUsers/$(request.auth.uid)).data.usernameLower == usernameLower
        && getAfter(/databases/$(database)/documents/publicUsers/$(request.auth.uid)).data.username == request.resource.data.username
        && request.resource.data.keys().hasOnly(["uid", "username", "usernameLower", "createdAt"]);
      allow update: if false;
      allow delete: if own(resource.data.uid);
    }

    match /users/{uid} {
      allow get: if own(uid);
      allow list: if false;
      allow create: if own(uid)
        && request.resource.data.keys().hasOnly(["contactEmail", "settings", "createdAt", "authProvider"]);
      allow update: if own(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["contactEmail", "settings", "updatedAt", "phoneNumber", "phoneVerified", "phoneVisible"]);
      allow delete: if own(uid);
    }

    match /publicUsers/{uid} {
      // A newly authenticated user may read their own missing profile during registration,
      // even if the identity provider has not populated email_verified yet.
      allow get: if own(uid) || verified();
      allow list: if verified();
      allow create: if own(uid)
        && request.resource.data.username is string
        && request.resource.data.usernameLower is string
        && request.resource.data.username == request.resource.data.usernameLower
        && request.resource.data.usernameLower.matches('[a-z0-9_]{3,20}')
        && getAfter(/databases/$(database)/documents/usernameIndex/$(request.resource.data.usernameLower)).data.uid == uid
        && request.resource.data.keys().hasOnly([
          "username", "usernameLower", "displayName", "bio", "avatarUrl", "profileColor", "lastSeenAt", "phonePublic"
        ]);
      allow update: if own(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["username", "usernameLower", "displayName", "bio", "avatarUrl", "profileColor", "lastSeenAt", "phonePublic"])
        && (
          (request.resource.data.username == resource.data.username
            && request.resource.data.usernameLower == resource.data.usernameLower)
          ||
          (request.resource.data.username is string
            && request.resource.data.username == request.resource.data.usernameLower
            && request.resource.data.usernameLower.matches('[a-z0-9_]{3,20}')
            && getAfter(/databases/$(database)/documents/usernameIndex/$(request.resource.data.usernameLower)).data.uid == uid)
        );
      allow delete: if own(uid);
    }

    match /chats/{chatId} {
      // A signed-in user may check a deterministic DM document before creating it.
      // Existing chats remain readable only by their members.
      allow get: if verified() && (
        !exists(/databases/$(database)/documents/chats/$(chatId))
        || chatId == "general"
        || request.auth.uid in resource.data.memberUids
      );
      allow list: if verified() && (
        chatId == "general"
        || request.auth.uid in resource.data.memberUids
      );

      allow create: if verified() && (
        (chatId == "general"
          && request.resource.data.type == "general"
          && request.resource.data.memberUids is list
          && request.resource.data.memberUids.size() == 0)
        ||
        (request.resource.data.type == "dm"
          && request.resource.data.memberUids is list
          && request.resource.data.memberUids.size() == 2
          && request.auth.uid in request.resource.data.memberUids
          && request.resource.data.ownerUid == request.auth.uid)
        ||
        (request.resource.data.type == "group"
          && request.resource.data.memberUids is list
          && request.resource.data.memberUids.size() >= 2
          && request.resource.data.memberUids.size() <= 50
          && request.auth.uid in request.resource.data.memberUids
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 40)
      );

      allow update: if verified() && (
        (
          (chatId == "general" || request.auth.uid in resource.data.memberUids)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["lastMessage", "lastSenderUid", "lastSenderName", "lastMessageAt", "updatedAt", "memberUids"])
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(["memberUids"])
            ||
            (request.auth.uid in resource.data.memberUids
              && !(request.auth.uid in request.resource.data.memberUids)
              && request.resource.data.memberUids.size() == resource.data.memberUids.size() - 1)
          )
          && (!("lastMessage" in request.resource.data)
            || (request.resource.data.lastMessage is string
              && request.resource.data.lastMessage.size() <= 120))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["lastSenderUid"])
            || request.resource.data.lastSenderUid == request.auth.uid)
          && (!("lastSenderName" in request.resource.data)
            || (request.resource.data.lastSenderName is string
              && request.resource.data.lastSenderName.size() <= 40))
        )
        ||
        (
          resource.data.type == "group"
          && resource.data.ownerUid == request.auth.uid
          && request.auth.uid in resource.data.memberUids
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["title", "description", "memberUids", "memberProfiles", "updatedAt"])
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 40
          && (!("description" in request.resource.data)
            || (request.resource.data.description is string
              && request.resource.data.description.size() <= 300))
          && request.resource.data.memberUids is list
          && request.resource.data.memberUids.size() >= 2
          && request.resource.data.memberUids.size() <= 50
          && request.auth.uid in request.resource.data.memberUids
          && request.resource.data.memberProfiles is list
          && request.resource.data.memberProfiles.size() == request.resource.data.memberUids.size()
        )
      );

      // A member may leave through the memberUids self-removal update,
      // but only a future trusted admin flow may delete a chat document.
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if canReadChat(chatId);
        allow create: if canReadChat(chatId)
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.username == get(/databases/$(database)/documents/publicUsers/$(request.auth.uid)).data.username
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() <= 60
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 4000
          && (request.resource.data.text.size() > 0
            || ("attachment" in request.resource.data && request.resource.data.attachment is map))
          && request.resource.data.createdAt == request.time
          && request.resource.data.readBy is list
          && request.resource.data.readBy.size() == 1
          && request.auth.uid in request.resource.data.readBy
          && (!("profileColor" in request.resource.data) || request.resource.data.profileColor is string)
          && (!("avatarUrl" in request.resource.data) || request.resource.data.avatarUrl is string)
          && request.resource.data.keys().hasOnly([
            "senderUid", "username", "displayName", "avatarUrl", "profileColor", "text", "createdAt", "attachment", "readBy", "replyTo"
          ])
          && (!("replyTo" in request.resource.data)
            || (request.resource.data.replyTo is map
              && request.resource.data.replyTo.keys().hasOnly(["id", "senderUid", "displayName", "text"])
              && request.resource.data.replyTo.id is string
              && request.resource.data.replyTo.senderUid is string
              && request.resource.data.replyTo.displayName is string
              && request.resource.data.replyTo.text is string
              && request.resource.data.replyTo.text.size() <= 160))
          && (!("attachment" in request.resource.data)
            || (request.resource.data.attachment.keys().hasOnly(["name", "type", "size", "url", "path"])
              && request.resource.data.attachment.name is string
              && request.resource.data.attachment.type is string
              && request.resource.data.attachment.size is int
              && request.resource.data.attachment.url is string
              && request.resource.data.attachment.path is string
              && request.resource.data.attachment.path.matches("chatFiles/" + chatId + "/" + request.auth.uid + "/.*")
              && request.resource.data.attachment.size <= 20 * 1024 * 1024));
        allow update: if canReadChat(chatId) && (
          (resource.data.senderUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["text", "editedAt"])
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 4000
            && request.resource.data.editedAt == request.time)
          ||
          (chatId != "general"
            && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberUids
            && request.auth.uid != resource.data.senderUid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["readBy"])
            && request.resource.data.readBy is list
            && request.auth.uid in request.resource.data.readBy
            && ((resource.data.readBy is list
              && !(request.auth.uid in resource.data.readBy)
              && request.resource.data.readBy.hasAll(resource.data.readBy)
              && request.resource.data.readBy.size() == resource.data.readBy.size() + 1)
              || (!("readBy" in resource.data)
                && request.resource.data.readBy.size() == 1)))
          ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(["hiddenFor"])
            && request.resource.data.hiddenFor is list
            && request.auth.uid in request.resource.data.hiddenFor
            && (("hiddenFor" in resource.data
              && request.resource.data.hiddenFor.hasAll(resource.data.hiddenFor)
              && !(request.auth.uid in resource.data.hiddenFor)
              && request.resource.data.hiddenFor.size() == resource.data.hiddenFor.size() + 1)
              || (!("hiddenFor" in resource.data) && request.resource.data.hiddenFor.size() == 1)))
        );
        allow delete: if canReadChat(chatId)
          && resource.data.senderUid == request.auth.uid;

        match /reactions/{userId} {
          allow read: if canReadChat(chatId);
          allow create, update: if canReadChat(chatId)
            && request.auth.uid == userId
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.emoji in ["❤️", "😂", "👍", "🔥", "😮", "😢", "🙏", "🎉", "💯", "👀", "😍", "🥰", "😘", "🤔", "👏", "🙌", "🤝", "💔", "😭", "😎", "🥳", "🤩", "🤗", "😡", "🤯", "💀", "✨", "🚀", "☕", "💖"]
            && request.resource.data.keys().hasOnly(["uid", "emoji", "updatedAt"]);
          allow delete: if canReadChat(chatId) && request.auth.uid == userId;
        }
      }
    }

    match /calls/{callId} {
      function callParticipant() {
        return verified()
          && request.auth.uid in resource.data.participantUids;
      }
      allow create: if verified()
        && request.resource.data.callerUid == request.auth.uid
        && request.resource.data.calleeUid is string
        && request.resource.data.calleeUid != request.auth.uid
        && request.resource.data.participantUids is list
        && request.resource.data.participantUids.size() == 2
        && request.auth.uid in request.resource.data.participantUids
        && request.resource.data.calleeUid in request.resource.data.participantUids
        && request.resource.data.status == "preparing"
        && exists(/databases/$(database)/documents/chats/$(request.resource.data.chatId))
        && request.auth.uid in get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)).data.memberUids
        && request.resource.data.calleeUid in get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)).data.memberUids
        && request.resource.data.keys().hasOnly([
          "chatId", "callerUid", "calleeUid", "participantUids", "status", "createdAt"
        ]);
      allow get: if callParticipant();
      allow list: if verified() && resource.data.calleeUid == request.auth.uid;
      allow update: if callParticipant()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["offer", "answer", "status", "updatedAt", "acceptedAt", "endedAt", "renegotiateOffer", "renegotiateAnswer"])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["offer"])
          || request.auth.uid == resource.data.callerUid)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["answer"])
          || request.auth.uid == resource.data.calleeUid)
        && (!("status" in request.resource.data)
          || request.resource.data.status in ["preparing", "ringing", "accepted", "declined", "ended"])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["renegotiateOffer"])
          || request.resource.data.renegotiateOffer.from == request.auth.uid)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["renegotiateAnswer"])
          || request.resource.data.renegotiateAnswer.from == request.auth.uid);
      allow delete: if false;

      match /{candidateSet}/{candidateId} {
        function isCallParticipant() {
          return verified()
            && exists(/databases/$(database)/documents/calls/$(callId))
            && request.auth.uid in get(/databases/$(database)/documents/calls/$(callId)).data.participantUids;
        }
        allow get, list: if isCallParticipant()
          && candidateSet in ["callerCandidates", "calleeCandidates"];
        allow create: if isCallParticipant()
          && candidateSet in ["callerCandidates", "calleeCandidates"]
          && request.resource.data.uid == request.auth.uid
          && (
            (candidateSet == "callerCandidates"
              && request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.callerUid)
            ||
            (candidateSet == "calleeCandidates"
              && request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.calleeUid)
          )
          && request.resource.data.candidate is map
          && request.resource.data.keys().hasOnly(["uid", "candidate", "createdAt"]);
        allow update, delete: if false;
      }
    }

    match /systemMigrations/{document=**} {
      allow read, write: if false;
    }
  }
}
