rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    // Profile photos: each signed-in user can manage only their own avatar.
    match /avatars/{userId}/{fileName} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
      allow delete: if signedIn()
        && request.auth.uid == userId;
    }

    // Chat uploads: each user can upload only into their own UID folder.
    // Firestore rules independently control whether the resulting message
    // can be created in the selected chat and who can read that chat.
    match /chatFiles/{chatId}/{userId}/{fileName} {
      allow read: if signedIn()
        && (
          chatId == "general"
          || (
            firestore.exists(/databases/(default)/documents/chats/$(chatId))
            && request.auth.uid in firestore.get(/databases/(default)/documents/chats/$(chatId)).data.memberUids
          )
        );

      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 20 * 1024 * 1024
        && request.resource.contentType is string
        && request.resource.contentType.size() <= 120;

      allow delete: if signedIn()
        && request.auth.uid == userId;
    }
  }
}