rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }
    function frossSessionApproved() {
      return (
        request.auth.token.keys().hasAny(["frossDeviceId"])
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && "trustedDeviceIds" in firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data
        && request.auth.token.frossDeviceId in firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.trustedDeviceIds
      ) || (
        request.auth.token.keys().hasAny(["frossBrowserSession"])
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && "approvedBrowserSessions" in firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.approvedBrowserSessions.keys().hasAny([request.auth.token.frossBrowserSession])
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.approvedBrowserSessions[request.auth.token.frossBrowserSession].expiresAt > request.time
      );
    }
    function verified() {
      return signedIn()
        && (request.auth.token.email_verified == true || request.auth.token.legacyAccount == true)
        && (
          !firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
          || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.requireBrowserApproval != true
          || frossSessionApproved()
        );
    }
    function isChatMember(chatId) {
      return verified()
        && firestore.exists(/databases/(default)/documents/chats/$(chatId))
        && (chatId == "general" || request.auth.uid in firestore.get(/databases/(default)/documents/chats/$(chatId)).data.memberUids);
    }

    match /avatars/{userId}/{fileName} {
      allow read: if verified();
      allow write: if verified()
        && request.auth.uid == userId
        && (
          request.resource == null
          || (
            request.resource.size < 5 * 1024 * 1024
            && request.resource.contentType.matches('image/(jpeg|png|webp|gif)')
          )
        );
    }

    match /chatFiles/{chatId}/{userId}/{fileName} {
      allow read: if isChatMember(chatId);
      allow write: if isChatMember(chatId)
        && request.auth.uid == userId
        && (
          request.resource == null
          || (
            request.resource.size < 20 * 1024 * 1024
            && request.resource.contentType.matches('(image/.*|video/.*|audio/.*|application/.*|text/.*)')
          )
        );
    }
  }
}
