rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }
    function isChatMember(chatId) {
      return signedIn()
        && (
          request.auth.token.email_verified == true
          || request.auth.token.legacyAccount == true
        )
        && firestore.exists(/databases/(default)/documents/chats/$(chatId))
        && request.auth.uid in firestore.get(/databases/(default)/documents/chats/$(chatId)).data.memberUids;
    }

    match /avatars/{userId}/{fileName} {
      allow read: if signedIn();
      allow write: if signedIn()
        && request.auth.uid == userId
        && (
          request.resource == null
          || (
            request.resource.size < 5 * 1024 * 1024
            && request.resource.contentType.matches('image/(jpeg|png|webp|gif)')
          )
        );
    }

    match /chatFiles/{chatId}/{userId}/{fileName} {
      allow read: if isChatMember(chatId);
      allow write: if isChatMember(chatId)
        && request.auth.uid == userId
        && (
          request.resource == null
          || (
            request.resource.size < 20 * 1024 * 1024
            && request.resource.contentType.matches('(image/.*|video/.*|audio/.*|application/.*|text/.*)')
          )
        );
    }
  }
}
