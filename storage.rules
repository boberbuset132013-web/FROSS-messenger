rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function verified() {
      return signedIn() && (
        request.auth.token.email_verified == true
        || request.auth.token.legacyAccount == true
      );
    }

    // Profile photos are visible to signed-in users; each user can manage only their own avatar.
    match /avatars/{userId}/{fileName} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
      allow delete: if signedIn()
        && request.auth.uid == userId;
    }

    // Chat files are readable only by verified members of that chat.
    function isChatMember(chatId) {
      return verified() && (
        chatId == "general"
        || (
          firestore.exists(/databases/(default)/documents/chats/$(chatId))
          && request.auth.uid in firestore.get(/databases/(default)/documents/chats/$(chatId)).data.memberUids
        )
      );
    }

    match /chatFiles/{chatId}/{userId}/{fileName} {
      allow read: if isChatMember(chatId);

      allow create, update: if isChatMember(chatId)
        && request.auth.uid == userId
        && request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 20 * 1024 * 1024
        && request.resource.contentType is string
        && request.resource.contentType.size() <= 120;

      // Uploader can remove their own file even after leaving a chat.
      allow delete: if signedIn()
        && request.auth.uid == userId;
    }
  }
}