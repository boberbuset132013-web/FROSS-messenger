# Copy this file to functions/.env.fross-ca5d6 locally.
# Do not commit the copied file. The reset endpoint stays disabled unless this is exactly true.
ENABLE_DANGEROUS_TEST_RESET=false

# Generate with: openssl rand -hex 32. Required for six-digit FROSS Security browser codes.
FROSS_BROWSER_OTP_SECRET=replace-with-a-random-64-character-hex-secret

# Set true only in a dedicated test deployment using Firebase PNV test tokens.
FROSS_ALLOW_PNV_TEST_TOKENS=false

# Optional comma-separated exact web origins, e.g. https://fross.example
FROSS_ALLOWED_ORIGINS=
